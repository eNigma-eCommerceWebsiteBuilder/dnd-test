{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "scripts/templatefrontend-parser/**/*.ts",
    "scripts/check-parser-boundary.ts",
    "packages/puck-site-contract/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
